.venv/
__pycache__/
*.pyc
tokens_horizon/runs/cache/
# logs carry absolute host paths; kept on the build host only
tokens_horizon/runs/**/*.log
# model weights: manifest committed instead (runs/learned/MANIFEST.csv)
tokens_horizon/runs/learned/**/*.pt
# KS/Kolmogorov codebooks (large): manifest committed instead (runs/ext/*/CODEBOOK_MANIFEST.csv)
tokens_horizon/runs/ext/ks/codebooks/
tokens_horizon/runs/ext/kolmo/codebooks/
# EXT2 FSQ weights: manifest committed instead (runs/ext2/train/MANIFEST.csv)
tokens_horizon/runs/ext2/**/*.pt
