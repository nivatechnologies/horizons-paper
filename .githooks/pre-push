#!/usr/bin/env python3
import subprocess,sys
for line in sys.stdin:
 fields=line.split()
 if len(fields)!=4:continue
 oid=fields[1]
 if set(oid)=={'0'}:continue
 objects=subprocess.check_output(['git','rev-list','--objects',oid],text=True)
 for row in objects.splitlines():
  fields=row.split(' ',1)
  if len(fields)==2 and fields[1].startswith('aspen/determinacy/runs/') and fields[1].lower().endswith('.npz'):
   print('Push blocked: history contains local scientific arrays: '+fields[1],file=sys.stderr);sys.exit(1)
